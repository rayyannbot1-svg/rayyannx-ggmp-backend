
const express = require("express");
const jwt = require("jsonwebtoken");
const bcrypt = require("bcryptjs");
const helmet = require("helmet");
const rateLimit = require("express-rate-limit");

const app = express();

app.use(helmet());
app.use(express.json({ limit: "10kb" }));

app.use("/auth/", rateLimit({
  windowMs: 15 * 60 * 1000,
  limit: 20
}));

const SECRET = process.env.JWT_SECRET;

if (!SECRET) {
  throw new Error("JWT_SECRET belum diatur");
}

// Contoh akun awal.
// Ganti dengan database dan password hash
// sebelum digunakan untuk pengguna sungguhan.
const users = [];

app.get("/health", (req, res) => {
  res.json({ status: "online" });
});

app.post("/auth/login", async (req, res) => {
  const { username, password, licenseKey } = req.body || {};

  if (!username || !password || !licenseKey) {
    return res.status(400).json({
      success: false,
      message: "Semua kolom wajib diisi"
    });
  }

  const user = users.find(u => u.username === username);

  if (!user || !(await bcrypt.compare(password, user.passwordHash))) {
    return res.status(401).json({
      success: false,
      message: "Username atau password salah"
    });
  }

  if (user.active !== true) {
    return res.status(403).json({
      success: false,
      message: "Akun tidak aktif"
    });
  }

  if (user.licenseKey !== licenseKey) {
    return res.status(403).json({
      success: false,
      message: "License Key tidak valid"
    });
  }

  const token = jwt.sign(
    { sub: user.username, role: "PREMIUM" },
    SECRET,
    { expiresIn: "1h" }
  );

  return res.json({
    success: true,
    status: "PREMIUM",
    token
  });
});

const PORT = process.env.PORT || 3000;

app.listen(PORT, "0.0.0.0", () => {
  console.log("RayyannX server running on " + PORT);
});
